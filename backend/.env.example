# ─── News API ─────────────────────────────────────────────────────────────────
# Get your free key at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/newsaggregator
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/newsaggregator
MONGODB_URI=mongodb://localhost:27017/newsaggregator

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
